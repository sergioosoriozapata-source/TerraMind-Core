<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TerraMind.State\TerraMind.State.csproj" />
    <ProjectReference Include="..\TerraMind.Memory\TerraMind.Memory.csproj" />
    <ProjectReference Include="..\TerraMind.Brain\TerraMind.Brain.csproj" />
    <ProjectReference Include="..\TerraMind.Input\TerraMind.Input.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
