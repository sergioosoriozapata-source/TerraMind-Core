{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-release",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/TerraMind-Core.sln", "-c", "Release"],
      "type": "process",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "run-prehardmode",
      "command": "${workspaceFolder}/src/TerraMind.App/bin/Release/net8.0/TerraMind.App.exe",
      "args": ["--farm", "--minutes", "10"],
      "type": "process",
      "dependsOn": ["build-release"],
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "run-hardmode",
      "command": "${workspaceFolder}/src/TerraMind.App/bin/Release/net8.0/TerraMind.App.exe",
      "args": ["--farm", "--minutes", "15"],
      "type": "process",
      "dependsOn": ["build-release"],
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "run-empress",
      "command": "${workspaceFolder}/src/TerraMind.App/bin/Release/net8.0/TerraMind.App.exe",
      "args": ["--hunt", "EmpressOfLight", "--minutes", "15"],
      "type": "process",
      "dependsOn": ["build-release"],
      "presentation": { "reveal": "always", "panel": "new" }
    }
  ]
}
